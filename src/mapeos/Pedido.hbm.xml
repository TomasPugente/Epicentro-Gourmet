<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="datos.Pedido" table="Pedido">
        <id column="idPedido" name="idPedido">
            <generator class="identity" />
        </id>
        
        <property name="fechaTransaccion" column="FechaTransaccion" type="LocalDate" not-null="true" />

        <many-to-one name="unidadDeVenta" class="datos.UnidadDeVenta" column="idUnidadDeVenta" not-null="true" />
        <set name="platos" table="Plato" inverse="true" lazy="true" cascade="all">
            <key column="idPedido" />
            <one-to-many class="datos.Plato" />
        </set>
    </class>
</hibernate-mapping>